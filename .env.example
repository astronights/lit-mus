# --- Database (Neon) ---------------------------------------------------------
# Pooled connection string from the Neon dashboard. The serverless HTTP driver
# uses this over fetch, so it works inside Vercel functions without a pool.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Better Auth) ------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the deployment; used for cookie + callback URLs.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shared secret required at signup. Keeps the public URL from collecting
# junk accounts without building an invite system (Section 5d).
INVITE_CODE="change-me"

# --- Question generation (Gemini Flash, free tier) ---------------------------
GEMINI_API_KEY=""
#
# One book = one call, so the free tier's DAILY cap is the binding constraint:
# a drill session is a dozen calls. Published free-tier limits, requests per
# minute / per day (Google revises these -- check ai.google.dev/gemini-api/docs/rate-limits):
#
#   gemini-2.5-flash-lite    15 / 1000   <- default. Most headroom by far.
#   gemini-2.5-flash         10 /  250       Better recall, ~2 sessions a day.
#   gemini-2.0-flash         15 /  200
#   gemini-2.0-flash-lite    30 /  200
#   gemini-2.5-pro            5 /  100       Best questions, tiny allowance.
#
# Leave unset to take the default. Recall matters here -- the riddles need the
# model to know a book beyond the blurb we hand it -- so if questions come out
# generic, move up a tier and accept the smaller allowance.
GEMINI_MODEL=""
#
# Ceilings for the generation queue. Leave these blank and they follow whichever
# model is set above (see FREE_TIER in src/lib/questions/generate.ts); set them
# to go below that. On a 429 the app stops asking for 15 minutes rather than
# repeating a doomed call per book.
#
# NOTE: these are only global if UPSTASH_REDIS_* below are set. Without them the
# limiter counts per function instance, which on Vercel is barely a limit.
GEMINI_MAX_REQUESTS_PER_MINUTE=""
GEMINI_MAX_REQUESTS_PER_DAY=""

# --- Rate limiting (optional; falls back to in-process counters) -------------
# Upstash Redis REST credentials. Without these the limiter still works, but
# only per serverless instance -- fine locally, weak in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Seed job ----------------------------------------------------------------
# Comma-separated subset of the sources in src/lib/seed-sources.ts.
# Empty/unset means "all enabled sources".
SEED_SOURCES=""
# Secret for POST /api/cron/seed, so the Vercel Cron endpoint is not open.
CRON_SECRET=""
