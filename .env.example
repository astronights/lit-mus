# --- Database (Neon) ---------------------------------------------------------
# Pooled connection string from the Neon dashboard. The serverless HTTP driver
# uses this over fetch, so it works inside Vercel functions without a pool.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Better Auth) ------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the deployment; used for cookie + callback URLs.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shared secret required at signup. Keeps the public URL from collecting
# junk accounts without building an invite system (Section 5d).
INVITE_CODE="change-me"

# --- Question generation (Gemini Flash, free tier) ---------------------------
GEMINI_API_KEY=""
#
# Which model. Unset uses gemini-2.5-flash-lite -- a stable, long-lived id, not
# the best one available. Prefer a current Gemini 3 Flash / Flash-Lite: better
# recall, which is what these questions live on, and a larger free allowance.
#
#   npm run check:models
#
# lists the exact ids YOUR key can use, and flags the configured one if it is
# not among them. Worth doing rather than copying an id from anywhere (this file
# included): the ids move, 3.x uses a dotted scheme, and a stale id 404s on
# every single call -- which in the app reads as "generation is broken".
GEMINI_MODEL=""
#
# Ceilings for the generation queue, per minute and per day. Unset falls back to
# a low, model-agnostic floor (5 / 100) whose only job is to stop a runaway
# loop. There is no table of per-model quotas in the repo on purpose: the free
# tier cap is per project and varies with region, account age and billing, so
# any table would be wrong in a way nobody notices. AI Studio shows the real
# number for your project -- put it here.
#
# The backstop is Google's own 429: the app then stops asking for as long as the
# response says to wait, which distinguishes a per-minute blip (~a minute) from
# an exhausted daily allowance.
#
# NOTE: these are only global if UPSTASH_REDIS_* below are set. Without them the
# limiter counts per function instance, which on Vercel is barely a limit.
GEMINI_MAX_REQUESTS_PER_MINUTE=""
GEMINI_MAX_REQUESTS_PER_DAY=""

# --- Rate limiting (optional; falls back to in-process counters) -------------
# Upstash Redis REST credentials. Without these the limiter still works, but
# only per serverless instance -- fine locally, weak in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Seed job ----------------------------------------------------------------
# Comma-separated subset of the sources in src/lib/seed-sources.ts.
# Empty/unset means "all enabled sources".
SEED_SOURCES=""
# Secret for POST /api/cron/seed, so the Vercel Cron endpoint is not open.
CRON_SECRET=""
