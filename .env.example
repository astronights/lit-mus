# --- Database (Neon) ---------------------------------------------------------
# Pooled connection string from the Neon dashboard. The serverless HTTP driver
# uses this over fetch, so it works inside Vercel functions without a pool.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Better Auth) ------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the deployment; used for cookie + callback URLs.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shared secret required at signup. LEAVE EMPTY FOR OPEN SIGNUP -- unset is a
# supported setting, not a misconfiguration, and the form hides the field.
#
# Opening it up is cheap here in the way that matters: Wikipedia hydration and
# the Gemini call are paid once per *book*, globally, so the second reader of a
# book costs nothing and the hundredth costs nothing. More readers do not
# multiply the API spend, they only reach the unopened books sooner.
INVITE_CODE=""
# Hard ceiling on accounts. Unset means no ceiling, which is fine while
# INVITE_CODE is doing the gatekeeping -- but with an open form this is the only
# thing between a public URL and however many rows a script cares to make. The
# per-IP signup limit (5/hour, in src/lib/auth.ts) slows that down, it does not
# stop it. Set it a bit above however many people you actually expect.
MAX_ACCOUNTS=""

# --- Question generation (Gemini Flash, free tier) ---------------------------
GEMINI_API_KEY=""
#
# Which model. Leave unset -- the app asks your key what it can use and picks
# the best (newest family, Flash tier, stable over preview). It logs the choice
# as `[questions] using Gemini model "..." (auto-selected)`.
#
# There is no hard-coded model id on purpose: they move faster than the repo
# does, and a stale one 404s on EVERY call, which reads as "generation is
# broken" rather than "one setting is out of date".
#
#   npm run check:models    # shows the listing, the ranking, and the pick
#
# Set this only to override that -- e.g. to force a Pro model, or to pin one
# build. An explicit value is never second-guessed.
GEMINI_MODEL=""
#
# Ceilings for the generation queue, per minute and per day. Unset falls back to
# a model-agnostic runaway-loop guard (10 / 250), not a mirror of anyone's
# quota. There is no table of per-model quotas in the repo on purpose: the free
# tier cap is per project and varies with region, account age and billing, so
# any table would be wrong in a way nobody notices. AI Studio shows the real
# number for your project -- put it here.
#
# The backstop is Google's own 429: the app then stops asking for as long as the
# response says to wait, which distinguishes a per-minute blip (~a minute) from
# an exhausted daily allowance.
#
# NOTE: these are only global if UPSTASH_REDIS_* below are set. Without them the
# limiter counts per function instance, which on Vercel is barely a limit.
GEMINI_MAX_REQUESTS_PER_MINUTE=""
GEMINI_MAX_REQUESTS_PER_DAY=""

# --- Rate limiting (optional; falls back to in-process counters) -------------
# Upstash Redis REST credentials. Without these the limiter still works, but
# only per serverless instance -- fine locally, weak in production, and it is
# what makes the Gemini daily cap and the 429 cooldown actually global.
#
# `KV_REST_API_URL` / `KV_REST_API_TOKEN` are also accepted, which is what
# Vercel's Upstash integration writes on its own -- so on Vercel there is
# usually nothing to copy. If you do copy by hand, note that the integration
# emits five variables and only two work:
#
#   KV_REST_API_URL              <- this one (https://...upstash.io)
#   KV_REST_API_TOKEN            <- and this one
#   KV_REST_API_READ_ONLY_TOKEN  -- no: the limiter INCRs, reads alone fail
#   KV_URL / REDIS_URL           -- no: rediss:// TCP, not the REST endpoint
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Seed job ----------------------------------------------------------------
# Comma-separated subset of the sources in src/lib/seed-sources.ts.
# Empty/unset means "all enabled sources".
SEED_SOURCES=""
# Secret for POST /api/cron/seed, so the Vercel Cron endpoint is not open.
CRON_SECRET=""
